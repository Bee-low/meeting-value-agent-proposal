{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.1.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Bupa",
    "websiteUrl": "https://www.bupa.com/",
    "privacyUrl": "https://www.bupa.com/privacy",
    "termsOfUseUrl": "https://www.bupa.com/legal-notices"
  },
  "name": {
    "short": "Meeting Value",
    "full": "Bupa Meeting Value Agent"
  },
  "description": {
    "short": "Assess meeting cost, outcomes, and actions.",
    "full": "A Bupa Microsoft Teams agent that estimates role-based meeting cost and assesses whether agendas, outcomes, decisions, and actions justified the time invested."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "0079C8",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "composeExtensions": [],
  "staticTabs": [
    {
      "entityId": "meeting-value-proposal",
      "name": "Meeting Value",
      "contentUrl": "${{PUBLIC_APP_URL}}",
      "websiteUrl": "${{PUBLIC_APP_URL}}",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "${{PUBLIC_APP_URL}}",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupchat"]
    }
  ],
  "validDomains": [
    "${{PUBLIC_APP_DOMAIN}}"
  ],
  "webApplicationInfo": {
    "id": "${{AAD_APP_CLIENT_ID}}",
    "resource": "api://${{PUBLIC_APP_DOMAIN}}/${{AAD_APP_CLIENT_ID}}"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "OnlineMeeting.ReadBasic.Chat",
          "type": "Delegated"
        }
      ]
    }
  }
}
