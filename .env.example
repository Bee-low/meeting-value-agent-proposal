# Bot Framework / Azure Bot registration
MicrosoftAppType=MultiTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# Teams app package values
TEAMS_APP_ID=
BOT_ID=
AAD_APP_CLIENT_ID=

# Local bot server
PORT=3978
PUBLIC_APP_URL=https://bee-low.github.io/meeting-value-agent-proposal/
PUBLIC_APP_DOMAIN=bee-low.github.io

# Microsoft Graph app registration, to be enabled after tenant approval
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Azure OpenAI, optional for transcript/recap analysis
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
